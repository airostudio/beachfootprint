# Copy to apps/web/.env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# ── Database (required) ───────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Server-only. Bypasses row-level security — mark it "Sensitive" in Vercel.
SUPABASE_SERVICE_ROLE_KEY=
# Which tenant this deployment serves (must exist in the tenants table).
DEFAULT_TENANT_SLUG=beach-footprints-demo

# ── Admin (required in any deployed environment) ─────────────────────────────
# HTTP Basic Auth password for /admin and /api/admin. If unset on a deployment,
# the admin area is locked (503) rather than left open.
ADMIN_PASSWORD=

# ── Public site URL ───────────────────────────────────────────────────────────
# Used for the sitemap, robots.txt, canonical/OG metadata and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://www.beachfootprint.com.au

# ── Payments: Stripe (required to take orders) ───────────────────────────────
STRIPE_SECRET_KEY=
# Endpoint: https://<site>/api/webhooks/stripe. Subscribe to: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# checkout.session.expired, charge.refunded, charge.dispute.created.
STRIPE_WEBHOOK_SECRET=
# Optional — checkout is Stripe-hosted; only used to report key mode in admin.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Customer email: Resend (without these, emails are only logged) ───────────
RESEND_API_KEY=
EMAIL_FROM="Beach Footprints <orders@beachfootprint.com.au>"

# ── AliExpress dropshipping engine (required for AliExpress import/fulfilment) ─
DROPSHIP_ENGINE_URL=
DROPSHIP_ENGINE_API_KEY=
# Shared secret the engine signs its webhooks with (X-Dropship-Signature).
DROPSHIP_ENGINE_WEBHOOK_SECRET=

# ── Optional ──────────────────────────────────────────────────────────────────
# Enables AI category suggestions on import and the SEO copy button.
ANTHROPIC_API_KEY=
