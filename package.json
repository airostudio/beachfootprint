{
  "name": "trend-store",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "worker": "pnpm -C apps/worker build && node apps/worker/dist/index.js",
    "schema": "pnpm -C packages/db schema",
    "seed": "pnpm -C packages/db seed",
    "db:types": "pnpm -C packages/db types",
    "test": "pnpm -C packages/core test",
    "import:aliexpress": "pnpm -C apps/worker import:aliexpress --",
    "sync:aliexpress": "pnpm -C apps/worker sync:aliexpress",
    "fulfill:aliexpress": "pnpm -C apps/worker fulfill:aliexpress --",
    "sync:tracking": "pnpm -C apps/worker sync:tracking"
  }
}